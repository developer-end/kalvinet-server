# ====================================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE: .env.example
# ====================================================================================
# Canonical local PostgreSQL settings for KalviNet.
# Must match docker-compose.yml defaults and application-local.yaml.
#
# Usage:
#   cp .env.example .env
#   docker compose up -d postgres
#
# JDBC (Spring Boot local profile):
#   jdbc:postgresql://localhost:5454/kalvinet-local-dev
# ====================================================================================

# Database container (Docker Compose)
POSTGRES_DB=kalvinet-local-dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
POSTGRES_PORT=5454

# Optional overrides used by application-local.yaml / application.yaml
# CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000
# FRONTEND_URL=http://localhost:4200
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
