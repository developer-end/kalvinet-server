# ====================================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE: .env.example
# ====================================================================================
# [FUNCTIONALITY]:
#   Provides default environment variables for local Docker Compose PostgreSQL database setup.
#
# [USAGE]:
#   Copy this file to `.env` in project root directory to customize local credentials:
#   `cp .env.example .env`
# ====================================================================================

# Database Container Configuration
POSTGRES_DB=school-admin
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
POSTGRES_PORT=5432
